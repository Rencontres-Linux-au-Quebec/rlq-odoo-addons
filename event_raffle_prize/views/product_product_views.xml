<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_product_view_list_raffle_inventory" model="ir.ui.view">
        <field name="name">product.product.list.raffle.inventory</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Prize Inventory" create="0">
                <field name="display_name" string="Prize" />
                <field name="raffle_sponsor_id" />
                <field name="lst_price" string="Value" />
                <field name="raffle_band_id" />
                <field name="raffle_attendance" optional="show" />
                <field name="raffle_closing_prize" optional="show" />
                <field name="raffle_initial_qty" sum="Total" />
                <field name="raffle_qty_reserved" sum="Total" />
                <field name="raffle_qty_delivered" sum="Total" />
                <field name="raffle_qty_free" sum="Total" />
                <field name="raffle_event_ids" widget="many2many_tags" optional="hide" />
            </list>
        </field>
    </record>

    <record id="product_product_view_pivot_raffle_inventory" model="ir.ui.view">
        <field name="name">product.product.pivot.raffle.inventory</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Prize Inventory" sample="1">
                <field name="raffle_sponsor_id" type="row" />
                <field name="raffle_band_id" type="col" />
                <field name="raffle_initial_qty" type="measure" />
                <field name="raffle_qty_reserved" type="measure" />
                <field name="raffle_qty_delivered" type="measure" />
                <field name="raffle_qty_free" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="product_product_view_search_raffle_inventory" model="ir.ui.view">
        <field name="name">product.product.search.raffle.inventory</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Prize Inventory">
                <field name="name" />
                <field name="raffle_sponsor_id" />
                <field name="raffle_band_id" />
                <field name="raffle_event_ids" />
                <filter string="Closing Prizes" name="closing" domain="[('raffle_closing_prize', '=', True)]" />
                <filter string="Reserved" name="reserved" domain="[('raffle_qty_reserved', '>', 0)]" />
                <group expand="0" string="Group By">
                    <filter string="Sponsor" name="group_sponsor" context="{'group_by': 'raffle_sponsor_id'}" />
                    <filter string="Token Category" name="group_band" context="{'group_by': 'raffle_band_id'}" />
                    <filter string="Attendance" name="group_attendance" context="{'group_by': 'raffle_attendance'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_event_raffle_prize_inventory" model="ir.actions.act_window">
        <field name="name">Prize Inventory</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('is_raffle_prize', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="product_product_view_search_raffle_inventory" />
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'view_mode': 'list', 'view_id': ref('product_product_view_list_raffle_inventory')}),
                Command.create({'view_mode': 'pivot', 'view_id': ref('product_product_view_pivot_raffle_inventory')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sponsored prize yet</p>
            <p>Add the prizes in Sponsored Prizes: their stock and claims show up here.</p>
        </field>
    </record>
</odoo>
