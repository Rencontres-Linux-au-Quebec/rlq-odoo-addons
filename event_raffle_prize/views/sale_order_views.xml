<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_raffle_prize" model="ir.ui.view">
        <field name="name">sale.order.form.raffle.prize</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="raffle_prize_sale_type" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
