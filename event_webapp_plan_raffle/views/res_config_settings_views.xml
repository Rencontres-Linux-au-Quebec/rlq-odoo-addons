<odoo>
    <!-- Block "Home page" of the app "Event Web App" (view of
         event_webapp_plan): the checkbox of the "On site" card, the config
         parameter of models/res_config_settings.py, for every day. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.event_webapp_plan_raffle</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event_webapp_plan.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='event_webapp_plan']" position="inside">
                <block title="Home page" name="ewp_home_setting_container">
                    <setting
                        id="ewp_onsite_card"
                        help="Attendees tell the organizers that they are at the event. For information only: the attendance of the raffles comes from the check-in scan at the welcome desk."
                    >
                        <field name="ewp_onsite_card" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
