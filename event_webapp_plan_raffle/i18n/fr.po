msgstr "Votre prix vous a été envoyé par courriel."

#. module: event_webapp_plan_raffle
#. odoo-python
#: code:addons/event_webapp_plan_raffle/controllers/main.py:0
msgid "Your prize was shipped."
msgstr "Votre prix a été expédié."

