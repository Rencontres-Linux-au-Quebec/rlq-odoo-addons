#. module: event_webapp_plan_track
#: model_terms:ir.ui.view,arch_db:event_webapp_plan_track.event_webapp_view_form
msgid ""
"Published tracks of the events of the day, held\n"
"                        during its opening window. A track appears in the\n"
"                        agenda of the room that follows its location."
msgstr ""
"Présentations publiées des événements de la journée, tenues\n"
"                        pendant sa période d'ouverture. Une présentation "
"paraît dans\n"
"                        l'agenda de la salle qui suit son lieu."

#. module: event_webapp_plan_track
#: model:ir.model.fields,help:event_webapp_plan_track.field_event_webapp__track_ids
msgid ""
"Published tracks of the events of the day, held during its opening window, "
"cancelled ones left out."
msgstr ""
"Présentations publiées des événements de la journée, tenues pendant sa "
"période d'ouverture, sans celles qui sont annulées."

#. module: event_webapp_plan_track
#. odoo-python
#: code:addons/event_webapp_plan_track/models/event_webapp_room.py:0
msgid ""
"The track location %(location)s already serves the room %(room)s of this "
"day: a location serves one room per day."
msgstr ""
"Le lieu de présentation %(location)s sert déjà la salle %(room)s de cette "
"journée : un lieu sert une seule salle par journée."

#. module: event_webapp_plan_track
