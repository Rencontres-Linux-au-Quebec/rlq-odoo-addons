#. module: event_raffle_prize_sponsor
#: model:res.groups,comment:event_raffle_prize_sponsor.group_raffle_sponsorship_manager
msgid ""
"\n"
"            Set by the module for the users listed as sponsorship managers of an event: they approve\n"
"            and refuse the sponsored prizes of those events.\n"
"        "
msgstr ""
"\n"
"            Réglé par le module pour les utilisateurs nommés responsables des commandites d'un événement : ils approuvent\n"
"            et refusent les prix commandités de ces événements.\n"
"        "

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/product_template.py:0
msgid ""
"%(sponsor)s changed the prize %(prize)s for %(event)s, which waits for "
"review: check it again, its token category included, before approving it."
msgstr ""
"%(sponsor)s a modifié le prix %(prize)s pour %(event)s, qui attend sa "
"révision : vérifiez-le de nouveau, sa catégorie de jeton comprise, avant de "
"l'approuver."

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/product_template.py:0
msgid ""
"%(sponsor)s changed the refused prize %(prize)s for %(event)s: review it "
"again."
msgstr ""
"%(sponsor)s a modifié le prix refusé %(prize)s pour %(event)s : révisez-le "
"de nouveau."

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/product_template.py:0
msgid ""
"%(sponsor)s submitted the prize %(prize)s for %(event)s: set its token "
"category, then approve or refuse it."
msgstr ""
"%(sponsor)s a soumis le prix %(prize)s pour %(event)s : choisissez sa "
"catégorie de jeton, puis approuvez-le ou refusez-le."

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/event_registration.py:0
msgid ""
"%s has no valid email address: add the attendee's email to the registration "
"first."
msgstr ""
"%s n'a pas d'adresse courriel valide : ajoutez d'abord le courriel du "
"participant à l'inscription."

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/event_registration.py:0
msgid ""
"%s is an internal user: they sign in with their own account, no invitation "
"is needed."
msgstr ""
"%s est un utilisateur interne : il se connecte avec son propre compte, "
"aucune invitation n'est nécessaire."

#. module: event_raffle_prize_sponsor
#. odoo-python
#: code:addons/event_raffle_prize_sponsor/models/product_template.py:0
msgid ""
"%s waits for the approval of the organization: approve it instead of "
"restoring it."
msgstr ""
"%s attend l'approbation de l'organisation : approuvez-le plutôt que de le "
"restaurer."

#. module: event_raffle_prize_sponsor
#: model:mail.template,body_html:event_raffle_prize_sponsor.mail_template_sponsor_thanks
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"thanks\" t-value=\"object._raffle_thanks_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Hello <t t-out=\"thanks['sponsor']\">Sponsor</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Thank you for the prizes you offered for the raffle of <strong t-out=\"thanks['event']\">Event</strong>.\n"
"        Here are their winners.\n"
"    </p>\n"
"    <table class=\"o_raffle_sponsor_thanks_winners\" cellpadding=\"4\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; margin: 0px 0px 12px 0px;\">\n"
"        <thead>\n"
"            <tr style=\"text-align: left; border-bottom: 1px solid #cccccc;\">\n"
"                <th scope=\"col\">Winner</th>\n"
"                <th scope=\"col\">Prize</th>\n"
"                <th scope=\"col\">Token category</th>\n"
"                <th scope=\"col\" style=\"white-space: nowrap;\">Date</th>\n"
"                <th scope=\"col\">Delivery</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"        <tr t-foreach=\"thanks['winners']\" t-as=\"winner\" style=\"border-bottom: 1px solid #eeeeee;\">\n"
"            <td t-out=\"winner['name']\">Winner</td>\n"
"            <td t-out=\"winner['prize']\">Prize</td>\n"
"            <td t-out=\"winner['category']\">Token</td>\n"
"            <td style=\"white-space: nowrap;\" t-out=\"winner['date']\">Date</td>\n"
"            <td t-out=\"winner['mode']\">Handed over on site</td>\n"
"        </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin: 0px;\">With our thanks,</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"thanks\" t-value=\"object._raffle_thanks_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Bonjour <t t-out=\"thanks['sponsor']\">Commanditaire</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Merci pour les prix que vous avez offerts au tirage de <strong t-out=\"thanks['event']\">Événement</strong>.\n"
"        Voici leurs gagnants.\n"
"    </p>\n"
"    <table class=\"o_raffle_sponsor_thanks_winners\" cellpadding=\"4\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; margin: 0px 0px 12px 0px;\">\n"
"        <thead>\n"
"            <tr style=\"text-align: left; border-bottom: 1px solid #cccccc;\">\n"
"                <th scope=\"col\">Gagnant</th>\n"
"                <th scope=\"col\">Prix</th>\n"
"                <th scope=\"col\">Catégorie de jeton</th>\n"
"                <th scope=\"col\" style=\"white-space: nowrap;\">Date</th>\n"
"                <th scope=\"col\">Remise</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"        <tr t-foreach=\"thanks['winners']\" t-as=\"winner\" style=\"border-bottom: 1px solid #eeeeee;\">\n"
"            <td t-out=\"winner['name']\">Gagnant</td>\n"
"            <td t-out=\"winner['prize']\">Prix</td>\n"
"            <td t-out=\"winner['category']\">Jeton</td>\n"
"            <td style=\"white-space: nowrap;\" t-out=\"winner['date']\">Date</td>\n"
"            <td t-out=\"winner['mode']\">Remis sur place</td>\n"
"        </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin: 0px;\">Avec nos remerciements,</p>\n"
"</div>\n"
"            "

