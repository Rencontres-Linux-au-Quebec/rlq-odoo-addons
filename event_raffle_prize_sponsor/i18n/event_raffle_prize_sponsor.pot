#. module: event_raffle_prize_sponsor
#: model:mail.template,body_html:event_raffle_prize_sponsor.mail_template_sponsor_thanks
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"thanks\" t-value=\"object._raffle_thanks_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Hello <t t-out=\"thanks['sponsor']\">Sponsor</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Thank you for the prizes you offered for the raffle of <strong t-out=\"thanks['event']\">Event</strong>.\n"
"        Here are their winners.\n"
"    </p>\n"
"    <table class=\"o_raffle_sponsor_thanks_winners\" cellpadding=\"4\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; margin: 0px 0px 12px 0px;\">\n"
"        <thead>\n"
"            <tr style=\"text-align: left; border-bottom: 1px solid #cccccc;\">\n"
"                <th scope=\"col\">Winner</th>\n"
"                <th scope=\"col\">Prize</th>\n"
"                <th scope=\"col\">Token category</th>\n"
"                <th scope=\"col\" style=\"white-space: nowrap;\">Date</th>\n"
"                <th scope=\"col\">Delivery</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"        <tr t-foreach=\"thanks['winners']\" t-as=\"winner\" style=\"border-bottom: 1px solid #eeeeee;\">\n"
"            <td t-out=\"winner['name']\">Winner</td>\n"
"            <td t-out=\"winner['prize']\">Prize</td>\n"
"            <td t-out=\"winner['category']\">Token</td>\n"
"            <td style=\"white-space: nowrap;\" t-out=\"winner['date']\">Date</td>\n"
"            <td t-out=\"winner['mode']\">Handed over on site</td>\n"
"        </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin: 0px;\">With our thanks,</p>\n"
"</div>\n"
"            "
msgstr ""

