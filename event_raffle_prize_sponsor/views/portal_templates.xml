<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Entry of /my, shown while the user sponsors an event that is
         not over (see the portal controller of the module). -->
    <template id="portal_my_home_raffle_sponsor" name="Prizes for Raffle" inherit_id="portal.portal_my_home" priority="40">
        <div id="portal_common_category" position="inside">
            <t t-if="raffle_sponsor_open" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/event_raffle_prize_sponsor/static/src/img/raffle_prize.svg'" />
                <t t-set="title">Prizes for raffle</t>
                <t t-set="text">Offer prizes for the raffle of the events you sponsor</t>
                <t t-set="url" t-value="'/my/raffle-prizes'" />
                <t t-set="config_card" t-value="True" />
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_raffle_sponsor" name="Prizes for Raffle Breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'raffle_prizes'" class="breadcrumb-item active" aria-current="page">
                Prizes for raffle
            </li>
            <t t-if="page_name == 'raffle_prize'">
                <li class="breadcrumb-item">
                    <a href="/my/raffle-prizes">Prizes for raffle</a>
                </li>
                <li class="breadcrumb-item active text-break" aria-current="page" t-out="breadcrumb_title" />
            </t>
        </xpath>
    </template>

    <!-- What the pages show of one prize: `prize` is the dict of the
         controller's _raffle_sponsor_prize_values(). -->
    <template id="portal_raffle_sponsor_prize_details" name="Prize for Raffle Details">
        <dl class="o_raffle_sponsor_details row mb-0">
            <dt class="col-12 col-sm-5">State</dt>
            <dd class="col-12 col-sm-7">
                <span t-attf-class="badge #{prize['state_class']}" t-out="prize['state_label']" />
            </dd>
            <dt class="col-12 col-sm-5">Value</dt>
            <dd class="col-12 col-sm-7" t-out="prize['value']" />
            <dt class="col-12 col-sm-5">Offered quantity</dt>
            <dd class="col-12 col-sm-7" t-out="prize['quantity']" />
            <dt class="col-12 col-sm-5">Kind of prize</dt>
            <dd class="col-12 col-sm-7">
                <t t-if="prize['virtual']">Virtual prize, sent by email</t>
                <t t-else="">Physical prize, picked up on site</t>
            </dd>
            <t t-if="prize['given'] is not None">
                <dt class="col-12 col-sm-5">Units given</dt>
                <dd class="col-12 col-sm-7 o_raffle_sponsor_given" t-out="prize['given']" />
            </t>
            <t t-if="prize['band']">
                <dt class="col-12 col-sm-5">Token category</dt>
                <dd class="col-12 col-sm-7" t-out="prize['band']" />
            </t>
            <t t-if="prize['reason']">
                <dt class="col-12 col-sm-5">Reason of the refusal</dt>
                <dd class="col-12 col-sm-7 o_raffle_sponsor_reason" t-out="prize['reason']" />
            </t>
        </dl>
    </template>

    <template id="portal_raffle_sponsor_prizes" name="Prizes for Raffle">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Prizes for raffle</t>
            <div class="o_raffle_sponsor mt-3 mb-5">
                <h1 class="h2">Prizes for raffle</h1>
                <p class="o_raffle_sponsor_name">
                    Sponsor: <strong t-out="sponsor_name" />
                </p>
                <div t-if="message" class="o_raffle_sponsor_message alert alert-success" role="status" tabindex="-1">
                    <t t-out="message" />
                </div>
                <p>
                    The organization reviews each prize, sets its token category, then approves it. Until
                    then, you may change or withdraw it; an approved prize can no longer be changed.
                </p>
                <section
                    t-foreach="groups"
                    t-as="group"
                    class="o_raffle_sponsor_event mb-4"
                    t-attf-aria-labelledby="o_raffle_sponsor_event_#{group['event'].id}"
                >
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h2 class="h4 mb-0 text-break" t-attf-id="o_raffle_sponsor_event_#{group['event'].id}" t-out="group['event'].name" />
                        <a
                            t-attf-href="/my/raffle-prizes/new?event_id=#{group['event'].id}"
                            class="o_raffle_sponsor_add btn btn-primary"
                        >Add a prize<span class="visually-hidden"> for <t t-out="group['event'].name" /></span></a>
                    </div>
                    <p t-if="not group['prizes']" class="o_raffle_sponsor_empty">No prize yet for this event.</p>
                    <ul t-else="" class="o_raffle_sponsor_prizes list-unstyled mb-0">
                        <li t-foreach="group['prizes']" t-as="prize" class="o_raffle_sponsor_prize card mb-3">
                            <div class="card-body d-flex flex-wrap gap-3">
                                <img
                                    t-if="prize['has_image']"
                                    t-attf-src="/my/raffle-prizes/#{prize['id']}/image"
                                    alt=""
                                    width="96"
                                    height="96"
                                    loading="lazy"
                                    class="o_raffle_sponsor_thumb rounded"
                                />
                                <div class="o_raffle_sponsor_prize_body flex-grow-1">
                                    <h3 class="h5 card-title text-break" t-out="prize['name']" />
                                    <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_prize_details" />
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        <t t-if="prize['editable']">
                                            <a t-attf-href="/my/raffle-prizes/#{prize['id']}" class="btn btn-outline-primary">
                                                Change<span class="visually-hidden"> <t t-out="prize['name']" /></span>
                                            </a>
                                            <a t-attf-href="/my/raffle-prizes/#{prize['id']}/withdraw" class="btn btn-outline-danger">
                                                Withdraw<span class="visually-hidden"> <t t-out="prize['name']" /></span>
                                            </a>
                                        </t>
                                        <a t-else="" t-attf-href="/my/raffle-prizes/#{prize['id']}" class="btn btn-outline-secondary">
                                            View<span class="visually-hidden"> <t t-out="prize['name']" /></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>
        </t>
    </template>

    <!-- Message of the form field `field` when it is in `errors`. Its id,
         o_raffle_sponsor_<field>_error, is in the aria-describedby of the
         field. -->
    <template id="portal_raffle_sponsor_field_error" name="Prize for Raffle Field Error">
        <p
            t-if="field in errors"
            t-attf-id="o_raffle_sponsor_#{field}_error"
            class="o_raffle_sponsor_field_error invalid-feedback d-block fw-bold"
        >
            <span class="visually-hidden">Error: </span><t t-out="errors[field]" />
        </p>
    </template>

    <template id="portal_raffle_sponsor_prize_form" name="Prize for Raffle Form">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="title" />
            <div class="o_raffle_sponsor o_raffle_sponsor_form_page mt-3 mb-5">
                <h1 class="h2 text-break" t-out="title" />
                <div
                    t-if="error_list"
                    id="o_raffle_sponsor_errors"
                    class="o_raffle_sponsor_errors alert alert-danger"
                    role="alert"
                    tabindex="-1"
                    aria-labelledby="o_raffle_sponsor_errors_title"
                >
                    <h2 id="o_raffle_sponsor_errors_title" class="h5" t-out="errors_title" />
                    <ul class="mb-0">
                        <li t-foreach="error_list" t-as="error">
                            <a t-attf-href="#o_raffle_sponsor_#{error['field']}" class="alert-link" t-out="error['message']" />
                        </li>
                    </ul>
                </div>
                <div t-if="prize and prize['reason']" class="o_raffle_sponsor_refused alert alert-warning" role="status">
                    <p class="fw-bold mb-1">The organization refused this prize:</p>
                    <p class="mb-1 o_raffle_sponsor_reason" t-out="prize['reason']" />
                    <p class="mb-0">Saving your changes submits the prize again.</p>
                </div>
                <p class="o_raffle_sponsor_name">
                    Sponsor: <strong t-out="sponsor_name" />
                </p>
                <p id="o_raffle_sponsor_required_help">
                    Fields marked with an asterisk (<span aria-hidden="true">*</span>) are required.
                </p>
                <form
                    t-att-action="action"
                    method="post"
                    enctype="multipart/form-data"
                    class="o_raffle_sponsor_form"
                    novalidate="novalidate"
                >
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <!-- Event: shown as text when the sponsor has one -->
                    <div class="mb-3">
                        <t t-if="len(events) == 1">
                            <p class="mb-0">
                                <span class="fw-bold">Event:</span> <span class="text-break" t-out="events.name" />
                            </p>
                            <input type="hidden" name="event_id" t-att-value="events.id" />
                        </t>
                        <t t-else="">
                            <t t-set="field" t-value="'event_id'" />
                            <label for="o_raffle_sponsor_event_id" class="form-label fw-bold">
                                Event <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <select
                                id="o_raffle_sponsor_event_id"
                                name="event_id"
                                class="form-select"
                                required="required"
                                t-att-aria-invalid="'true' if field in errors else None"
                                t-att-aria-describedby="'o_raffle_sponsor_event_id_error' if field in errors else None"
                            >
                                <option value="">Choose an event</option>
                                <option
                                    t-foreach="events"
                                    t-as="event"
                                    t-att-value="event.id"
                                    t-att-selected="str(event.id) == form.get('event_id') or None"
                                    t-out="event.name"
                                />
                            </select>
                            <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                        </t>
                    </div>
                    <div class="mb-3">
                        <t t-set="field" t-value="'name'" />
                        <label for="o_raffle_sponsor_name" class="form-label fw-bold">
                            Name of the prize <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <input
                            id="o_raffle_sponsor_name"
                            type="text"
                            name="name"
                            class="form-control"
                            required="required"
                            t-att-maxlength="name_max"
                            autocomplete="off"
                            t-att-value="form.get('name')"
                            t-att-aria-invalid="'true' if field in errors else None"
                            t-att-aria-describedby="'o_raffle_sponsor_name_error' if field in errors else None"
                        />
                        <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                    </div>
                    <div class="mb-3">
                        <t t-set="field" t-value="'description'" />
                        <label for="o_raffle_sponsor_description" class="form-label fw-bold">Description</label>
                        <textarea
                            id="o_raffle_sponsor_description"
                            name="description"
                            class="form-control"
                            rows="4"
                            t-att-maxlength="text_max"
                            t-att-aria-invalid="'true' if field in errors else None"
                            t-attf-aria-describedby="o_raffle_sponsor_description_help#{' o_raffle_sponsor_description_error' if field in errors else ''}"
                            t-out="form.get('description') or ''"
                        />
                        <p id="o_raffle_sponsor_description_help" class="form-text">
                            What the winners read about the prize, in plain text.
                        </p>
                        <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                    </div>
                    <div class="mb-3">
                        <t t-set="field" t-value="'photo'" />
                        <label for="o_raffle_sponsor_photo" class="form-label fw-bold">Photo</label>
                        <div t-if="prize and prize['has_image']" class="mb-2">
                            <img
                                t-attf-src="/my/raffle-prizes/#{prize['id']}/image"
                                alt="Current photo of the prize"
                                width="96"
                                height="96"
                                class="o_raffle_sponsor_thumb rounded"
                            />
                        </div>
                        <input
                            id="o_raffle_sponsor_photo"
                            type="file"
                            name="photo"
                            accept="image/jpeg,image/png,image/gif,image/webp"
                            class="form-control"
                            t-att-aria-invalid="'true' if field in errors else None"
                            t-attf-aria-describedby="o_raffle_sponsor_photo_help#{' o_raffle_sponsor_photo_error' if field in errors else ''}"
                        />
                        <p id="o_raffle_sponsor_photo_help" class="form-text">
                            JPEG, PNG, GIF or WebP image, <t t-out="photo_max_mb" /> MB at most.
                            <t t-if="prize and prize['has_image']">Leave it empty to keep the current photo.</t>
                        </p>
                        <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6 mb-3">
                            <t t-set="field" t-value="'value'" />
                            <label for="o_raffle_sponsor_value" class="form-label fw-bold">
                                Value ($) <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <input
                                id="o_raffle_sponsor_value"
                                type="text"
                                name="value"
                                inputmode="decimal"
                                class="form-control"
                                required="required"
                                autocomplete="off"
                                t-att-value="form.get('value')"
                                t-att-aria-invalid="'true' if field in errors else None"
                                t-attf-aria-describedby="o_raffle_sponsor_value_help#{' o_raffle_sponsor_value_error' if field in errors else ''}"
                            />
                            <p id="o_raffle_sponsor_value_help" class="form-text">
                                The retail value of one unit. The organization sets the token category from it.
                            </p>
                            <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                        </div>
                        <div class="col-12 col-sm-6 mb-3">
                            <t t-set="field" t-value="'quantity'" />
                            <label for="o_raffle_sponsor_quantity" class="form-label fw-bold">
                                Offered quantity <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <input
                                id="o_raffle_sponsor_quantity"
                                type="number"
                                name="quantity"
                                min="1"
                                step="1"
                                inputmode="numeric"
                                class="form-control"
                                required="required"
                                t-att-value="form.get('quantity')"
                                t-att-aria-invalid="'true' if field in errors else None"
                                t-attf-aria-describedby="o_raffle_sponsor_quantity_help#{' o_raffle_sponsor_quantity_error' if field in errors else ''}"
                            />
                            <p id="o_raffle_sponsor_quantity_help" class="form-text">
                                How many units you offer. The organization records the stock when it receives them.
                            </p>
                            <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                        </div>
                    </div>
                    <t t-set="field" t-value="'mode'" />
                    <fieldset class="mb-3">
                        <legend class="form-label fs-6 fw-bold">
                            Kind of prize <span class="text-danger" aria-hidden="true">*</span>
                        </legend>
                        <div class="form-check">
                            <input
                                id="o_raffle_sponsor_mode"
                                type="radio"
                                name="mode"
                                value="physical"
                                class="form-check-input"
                                required="required"
                                t-att-checked="form.get('mode') == 'physical' or None"
                                t-att-aria-invalid="'true' if field in errors else None"
                                t-att-aria-describedby="'o_raffle_sponsor_mode_error' if field in errors else None"
                            />
                            <label for="o_raffle_sponsor_mode" class="form-check-label">
                                Physical prize, picked up on site
                            </label>
                        </div>
                        <div class="form-check">
                            <input
                                id="o_raffle_sponsor_mode_virtual"
                                type="radio"
                                name="mode"
                                value="virtual"
                                class="form-check-input"
                                t-att-checked="form.get('mode') == 'virtual' or None"
                                t-att-aria-invalid="'true' if field in errors else None"
                                t-att-aria-describedby="'o_raffle_sponsor_mode_error' if field in errors else None"
                            />
                            <label for="o_raffle_sponsor_mode_virtual" class="form-check-label">
                                Virtual prize: a code or a link sent by email
                            </label>
                        </div>
                        <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                    </fieldset>
                    <div class="mb-4">
                        <t t-set="field" t-value="'instructions'" />
                        <label for="o_raffle_sponsor_instructions" class="form-label fw-bold">
                            Instructions for a virtual prize
                        </label>
                        <textarea
                            id="o_raffle_sponsor_instructions"
                            name="instructions"
                            class="form-control"
                            rows="4"
                            t-att-maxlength="text_max"
                            t-att-aria-invalid="'true' if field in errors else None"
                            t-attf-aria-describedby="o_raffle_sponsor_instructions_help#{' o_raffle_sponsor_instructions_error' if field in errors else ''}"
                            t-out="form.get('instructions') or ''"
                        />
                        <p id="o_raffle_sponsor_instructions_help" class="form-text">
                            For a virtual prize only: how the winner uses it, in plain text. The code or the link
                            itself is sent apart by the organization.
                        </p>
                        <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_field_error" />
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="o_raffle_sponsor_submit btn btn-primary">
                            <t t-if="prize">Save and submit</t>
                            <t t-else="">Submit the prize</t>
                        </button>
                        <a href="/my/raffle-prizes" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_raffle_sponsor_prize_view" name="Prize for Raffle">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="prize['name']" />
            <div class="o_raffle_sponsor mt-3 mb-5">
                <h1 class="h2 text-break" t-out="prize['name']" />
                <p>This prize is approved: ask the organization to change it.</p>
                <img
                    t-if="prize['has_image']"
                    t-attf-src="/my/raffle-prizes/#{prize['id']}/image"
                    alt="Photo of the prize"
                    width="96"
                    height="96"
                    class="o_raffle_sponsor_thumb rounded mb-3"
                />
                <p t-if="prize['description']" class="o_raffle_sponsor_description" t-out="prize['description']" />
                <t t-call="event_raffle_prize_sponsor.portal_raffle_sponsor_prize_details" />
                <a href="/my/raffle-prizes" class="btn btn-outline-secondary mt-3">Back to the prizes</a>
            </div>
        </t>
    </template>

    <template id="portal_raffle_sponsor_prize_withdraw" name="Withdraw a Prize for Raffle">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="title" />
            <div class="o_raffle_sponsor mt-3 mb-5">
                <h1 class="h2 text-break" t-out="title" />
                <p t-if="error" class="o_raffle_sponsor_withdraw_error alert alert-danger" role="alert" t-out="error" />
                <p>Withdrawing deletes the prize: the organization will not offer it.</p>
                <form t-attf-action="/my/raffle-prizes/#{prize['id']}/withdraw" method="post" class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <button type="submit" class="btn btn-danger">Withdraw the prize</button>
                    <a href="/my/raffle-prizes" class="btn btn-outline-secondary">Keep the prize</a>
                </form>
            </div>
        </t>
    </template>
</odoo>
