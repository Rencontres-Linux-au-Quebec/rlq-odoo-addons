<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.121.0 - RLQ registration desk (models/event_registration_desk.py). -->

    <!-- Full list of the registrations of the event (opened by « Open as a list »): native search, filters and grouping, same
         buttons. Every column is sortable by its header: the action carries the context key rlq_desk_event_id, read by
         event.registration._order_field_to_sql() (text without case or accents; computed columns thanks to allow_order). -->
    <record id="view_rlq_registration_desk_registration_list" model="ir.ui.view">
        <field name="name">event.registration.list.rlq.registration.desk</field>
        <field name="model">event.registration</field>
        <field name="priority">92</field>
        <field name="arch" type="xml">
            <list string="Registration desk" create="false" default_order="event_id desc, event_ticket_id, name"
                  decoration-success="state == 'done'" decoration-muted="state == 'draft'">
                <field name="event_id" optional="hide"/>
                <field name="event_ticket_id"/>
                <!-- v1.131.0: the name is a link to send a message in Odoo; sorted without case or accents (allow_order). -->
                <field name="rlq_desk_person" options="{'allow_order': True}"/>
                <field name="name" optional="hide"/>
                <field name="email" optional="hide"/>
                <field name="create_date" string="Registered on" optional="show" width="150px"/>
                <field name="state"/>
                <field name="date_closed" string="Arrived at" optional="show" width="150px"/>
                <field name="rlq_present_by" optional="show"/>
                <field name="rlq_departure" string="Left at" optional="show" width="150px"/>
                <field name="rlq_survey_state" options="{'allow_order': True}"/>
                <field name="rlq_desk_progress" options="{'allow_order': True}"/>
                <field name="rlq_desk_answers" options="{'allow_order': True}"/>
                <button name="action_rlq_desk_present" type="object" string="Present" icon="fa-check" class="btn-primary"
                        invisible="state == 'done'"/>
                <button name="action_rlq_desk_undo" type="object" string="Undo" icon="fa-undo"
                        invisible="state != 'done'" confirm="Undo the presence of this person?"/>
                <button name="action_rlq_desk_depart" type="object" string="Left" icon="fa-sign-out"
                        invisible="state != 'done' or rlq_departure"/>
                <button name="action_rlq_desk_depart_undo" type="object" string="Undo the departure" icon="fa-undo"
                        invisible="not rlq_departure" confirm="Clear the departure time of this person?"/>
            </list>
        </field>
    </record>

    <!-- Search of the full list: by person, and the filters « present » and « survey » (rlq_survey_state has a search method). -->
    <record id="view_rlq_registration_desk_registration_search" model="ir.ui.view">
        <field name="name">event.registration.search.rlq.registration.desk</field>
        <field name="model">event.registration</field>
        <field name="priority">92</field>
        <field name="arch" type="xml">
            <search string="Registration desk">
                <field name="name" string="Person" filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"/>
                <field name="event_ticket_id"/>
                <filter name="rlq_present" string="Present" domain="[('state', '=', 'done')]"/>
                <filter name="rlq_not_present" string="Not present yet" domain="[('state', '!=', 'done')]"/>
                <separator/>
                <filter name="rlq_survey_done" string="Survey completed" domain="[('rlq_survey_state', '=', 'done')]"/>
                <filter name="rlq_survey_in_progress" string="Survey started" domain="[('rlq_survey_state', '=', 'in_progress')]"/>
                <filter name="rlq_survey_not_started" string="Survey not started" domain="[('rlq_survey_state', '=', 'not_started')]"/>
                <filter name="rlq_survey_none" string="No survey" domain="[('rlq_survey_state', '=', 'none')]"/>
                <group expand="0" string="Group By">
                    <filter name="rlq_group_ticket" string="Ticket" context="{'group_by': 'event_ticket_id'}"/>
                    <filter name="rlq_group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- The desk: event, filters, sort, summary, list of the registrations with the buttons. -->
    <record id="view_rlq_registration_desk_form" model="ir.ui.view">
        <field name="name">rlq.registration.desk.form</field>
        <field name="model">rlq.registration.desk</field>
        <field name="arch" type="xml">
            <form string="RLQ registration desk">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" icon="fa-refresh" class="btn-primary"/>
                    <button name="action_open_list" type="object" string="Open as a list" icon="fa-list"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" options="{'no_create': True}" context="{'rlq_recent_first': True}"/>
                            <field name="event_date_text" readonly="1" invisible="not event_date_text"/>
                            <field name="sort_by"/>
                            <field name="sort_desc"/>
                        </group>
                        <group>
                            <field name="search_text" placeholder="Name, e-mail address or company"/>
                            <field name="survey_filter"/>
                            <field name="hide_present"/>
                            <field name="registration_count"/>
                        </group>
                    </group>
                    <field name="summary_html" readonly="1" nolabel="1"/>
                    <p class="text-muted">« Present » records the hour of arrival. The questions listed under « Answers » are the survey questions checked « Show at the registration desk ». A survey belongs to a registration when it was answered by the same contact or with the same e-mail address.</p>
                    <field name="registration_ids" readonly="1" nolabel="1">
                        <list limit="200" create="false" delete="false" decoration-success="state == 'done'" decoration-muted="state == 'draft'">
                            <field name="event_ticket_id"/>
                            <field name="rlq_desk_person" options="{'allow_order': True}"/>
                            <field name="create_date" string="Registered on" width="150px"/>
                            <field name="state"/>
                            <field name="date_closed" string="Arrived at" width="150px"/>
                            <field name="rlq_present_by" optional="show"/>
                            <field name="rlq_departure" string="Left at" width="150px"/>
                            <field name="rlq_survey_state" options="{'allow_order': True}"/>
                            <field name="rlq_desk_progress" options="{'allow_order': True}"/>
                            <field name="rlq_desk_answers" options="{'allow_order': True}"/>
                            <button name="action_rlq_desk_present" type="object" string="Present" icon="fa-check" class="btn-primary"
                                    invisible="state == 'done'"/>
                            <button name="action_rlq_desk_undo" type="object" string="Undo" icon="fa-undo"
                                    invisible="state != 'done'" confirm="Undo the presence of this person?"/>
                            <button name="action_rlq_desk_depart" type="object" string="Left" icon="fa-sign-out"
                                    invisible="state != 'done' or rlq_departure"/>
                            <button name="action_rlq_desk_depart_undo" type="object" string="Undo the departure" icon="fa-undo"
                                    invisible="not rlq_departure" confirm="Clear the departure time of this person?"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rlq_registration_desk" model="ir.actions.act_window">
        <field name="name">RLQ registration desk</field>
        <field name="res_model">rlq.registration.desk</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Button on the event form (xpath on //sheet: always present, see event_inscriptions_alerte_views.xml) -->
    <record id="view_event_form_rlq_registration_desk" model="ir.ui.view">
        <field name="name">event.event.form.rlq.registration.desk</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Registration desk" name="rlq_registration_desk">
                    <button name="action_rlq_registration_desk" type="object" string="RLQ registration desk" icon="fa-id-badge" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Box and short label on the survey question (same prudent xpath //sheet). If the form has no sheet, the fields still
         exist on survey.question and can be set from a list or by import. -->
    <record id="view_survey_question_form_rlq_registration_desk" model="ir.ui.view">
        <field name="name">survey.question.form.rlq.registration.desk</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Registration desk" name="rlq_registration_desk">
                    <field name="rlq_registration_desk"/>
                    <field name="rlq_desk_label" invisible="not rlq_registration_desk"/>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_rlq_registration_desk_events"
              name="RLQ registration desk"
              parent="event.event_main_menu"
              action="action_rlq_registration_desk"
              sequence="43"
              groups="event.group_event_user"/>

    <!-- v1.122.0 - Volunteers' coordinator (models/volunteer_coordinator.py): only the volunteer tickets. -->
    <record id="view_rlq_volunteer_coordinator_form" model="ir.ui.view">
        <field name="name">rlq.volunteer.coordinator.form</field>
        <field name="model">rlq.volunteer.coordinator</field>
        <field name="arch" type="xml">
            <form string="Volunteers">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" icon="fa-refresh" class="btn-primary"/>
                    <button name="action_export_excel" type="object" string="Export to a spreadsheet" icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" options="{'no_create': True}" context="{'rlq_recent_first': True}"/>
                            <field name="survey_filter"/>
                        </group>
                        <group>
                            <field name="sort_by"/>
                            <field name="sort_desc"/>
                        </group>
                    </group>
                    <field name="table_html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rlq_volunteer_coordinator" model="ir.actions.act_window">
        <field name="name">Volunteers</field>
        <field name="res_model">rlq.volunteer.coordinator</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_rlq_volunteer_coordinator_events"
              name="Volunteers"
              parent="event.event_main_menu"
              action="action_rlq_volunteer_coordinator"
              sequence="45"
              groups="event.group_event_user"/>

    <!-- v1.124.0 - The user guide in the Events menu too (controllers/aide.py), opened at the registration desk section. -->
    <record id="action_rlq_guide_events" model="ir.actions.act_url">
        <field name="name">User guide</field>
        <field name="url">/rlq_survey_report/aide#bureau-inscription</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_rlq_guide_events"
              name="User guide"
              parent="event.event_main_menu"
              action="action_rlq_guide_events"
              sequence="47"
              groups="event.group_event_user"/>

</odoo>
