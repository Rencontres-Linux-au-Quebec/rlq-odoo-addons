            </form>
        </field>
    </record>

    <record id="action_rlq_volunteer_expertise" model="ir.actions.act_window">
        <field name="name">Volunteer expertise</field>
        <field name="res_model">rlq.volunteer.expertise</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rlq_volunteer_expertise_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_rlq_volunteer_expertise_events"
              name="Volunteer expertise"
              parent="menu_rlq_reports_events"
              action="action_rlq_volunteer_expertise"
              sequence="35"
              groups="event.group_event_user"/>

    <menuitem id="menu_rlq_volunteer_expertise_surveys"
              name="Volunteer expertise"
              parent="menu_rlq_survey_report_in_survey_app"
              action="action_rlq_volunteer_expertise"
              sequence="78"
              groups="event.group_event_user"/>

    <!-- v1.138.0 - « Sujets d'intérêt » (audience_topics.py): the topics that could interest the audience, counted from the
         questions checked « Show in Topics of interest ». Two menus: every ticket, and the visitor tickets only. -->
    <record id="view_rlq_audience_topics_form" model="ir.ui.view">
        <field name="name">rlq.audience.topics.form</field>
        <field name="model">rlq.audience.topics</field>
        <field name="arch" type="xml">
            <form string="Topics of interest">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" icon="fa-refresh" class="btn-primary"/>
                    <button name="action_open_guide" type="object" string="Help for this page" icon="fa-question-circle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" options="{'no_create': True}" context="{'rlq_recent_first': True}"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <!-- v1.139.0: any ticket of the event, chosen one by one -->
                            <field name="ticket_ids" widget="many2many_tags" options="{'no_create': True}"
                                   invisible="scope != 'tickets'"/>
                        </group>
                    </group>
                    <field name="table_html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rlq_audience_topics" model="ir.actions.act_window">
        <field name="name">Topics of interest of the audience</field>
        <field name="res_model">rlq.audience.topics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rlq_audience_topics_form"/>
        <field name="target">current</field>
        <field name="context">{'default_scope': 'all'}</field>
    </record>

    <record id="action_rlq_audience_topics_visitors" model="ir.actions.act_window">
        <field name="name">Topics of interest of the visitors</field>
        <field name="res_model">rlq.audience.topics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rlq_audience_topics_form"/>
        <field name="target">current</field>
        <field name="context">{'default_scope': 'visitors'}</field>
    </record>

    <menuitem id="menu_rlq_audience_topics_events"
              name="Topics of interest of the audience"
              parent="menu_rlq_reports_events"
              action="action_rlq_audience_topics"
              sequence="36"
