<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v1.113.0 — Surveys not completed; v1.114.0 — daily report (models/event_survey_followup.py). -->

    <!-- Registrations whose survey is not completed (list opened by « Open as a list ») -->
    <record id="view_rlq_survey_pending_registration_list" model="ir.ui.view">
        <field name="name">event.registration.list.rlq.survey.pending</field>
        <field name="model">event.registration</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <list string="Surveys not completed" create="false" default_order="event_id desc, name" decoration-warning="rlq_survey_state == 'in_progress'">
                <field name="event_id"/>
                <field name="event_begin_date" string="Event date" optional="show" width="150px"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone" optional="hide"/>
                <field name="company_name" optional="hide"/>
                <field name="event_ticket_id" optional="show"/>
                <field name="rlq_expected_survey_id" optional="show"/>
                <field name="rlq_survey_state" widget="badge" decoration-danger="rlq_survey_state == 'not_started'" decoration-warning="rlq_survey_state == 'in_progress'" decoration-success="rlq_survey_state == 'done'"/>
                <field name="rlq_desk_progress" optional="hide"/>
                        <field name="rlq_attendance" optional="hide"/>
                <field name="rlq_survey_os" optional="show"/>
                <field name="rlq_survey_browser" optional="show"/>
                <field name="create_date" string="Registered on" optional="show" width="150px"/>
                <field name="state" optional="hide"/>
                <field name="date_closed" string="Arrived at" optional="hide" width="150px"/>
                <field name="rlq_present_by" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Wizard -->
    <record id="view_rlq_survey_pending_form" model="ir.ui.view">
        <field name="name">rlq.survey.pending.form</field>
        <field name="model">rlq.survey.pending</field>
        <field name="arch" type="xml">
            <form string="Surveys not completed">
                <!-- v1.141.0: surveys in « live session » mode block the participants -->
                <field name="live_session_html" readonly="1" nolabel="1" invisible="not live_session_html"/>
                <p>Confirmed registrations whose person has not completed the survey of their ticket (otherwise the survey of the event) yet. A survey belongs to a registration when it was answered by the same contact or with the same e-mail address.</p>
                <group>
                    <field name="event_ids" widget="many2many_tags" context="{'rlq_recent_first': True}"/>
                    <field name="include_started"/>
                    <!-- v1.145.0: on site or online; the reminders go to the people listed only -->
                    <field name="attendance_filter"/>
                </group>
                <group>
                    <group>
                        <field name="email_count"/>
                    </group>
                    <group>
                        <field name="missing_email_count" invisible="not missing_email_count"/>
                    </group>
                </group>
                <field name="emails" readonly="1" widget="CopyClipboardChar"/>
                <field name="registration_ids" readonly="1">
                    <!-- v1.128.0: more columns, chosen with the column menu at the right of the headers. -->
                    <list>
                        <field name="event_id"/>
                        <field name="event_begin_date" string="Event date" optional="hide" width="150px"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone" optional="hide"/>
                        <field name="company_name" optional="hide"/>
                        <field name="event_ticket_id"/>
                        <field name="rlq_expected_survey_id" optional="hide"/>
                        <field name="rlq_survey_state" widget="badge" decoration-danger="rlq_survey_state == 'not_started'" decoration-warning="rlq_survey_state == 'in_progress'" decoration-success="rlq_survey_state == 'done'"/>
                        <field name="rlq_desk_progress" optional="hide"/>
                        <field name="rlq_attendance" optional="hide"/>
                        <field name="rlq_survey_os" optional="show"/>
                        <field name="rlq_survey_browser" optional="show"/>
                        <field name="create_date" string="Registered on" optional="show" width="150px"/>
                        <field name="state" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_open_list" type="object" string="Open as a list" class="btn-primary"/>
                    <!-- v1.140.0: reminders, with the personal link of each person (administrators only) -->
                    <button name="action_send_reminder" type="object" string="Send a reminder" icon="fa-bell"
                            groups="survey.group_survey_manager,event.group_event_manager"
                            confirm="Send the invitation e-mail of their survey again to every person listed (each one receives their own link)?"/>
                    <button name="action_customize_reminder" type="object" string="Customize the reminder" icon="fa-pencil"
                            groups="survey.group_survey_manager,event.group_event_manager"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rlq_survey_pending" model="ir.actions.act_window">
        <field name="name">Surveys not completed</field>
        <field name="res_model">rlq.survey.pending</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Block on the event form (xpath on //sheet: always present, see event_inscriptions_alerte_views.xml) -->
    <record id="view_event_form_rlq_survey_followup" model="ir.ui.view">
        <field name="name">event.event.form.rlq.survey.followup</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Survey follow-up and daily report" name="rlq_survey_followup">
                    <group>
                        <field name="rlq_survey_pending_count"/>
                        <button name="action_rlq_survey_pending" type="object" string="Surveys not completed" icon="fa-envelope-o" colspan="2"/>
                    </group>
                    <group>
                        <field name="rlq_daily_report"/>
                        <field name="rlq_daily_report_sent" invisible="not rlq_daily_report_sent"/>
                        <button name="action_rlq_send_daily_report" type="object" string="Send the daily report now" icon="fa-paper-plane"
                                invisible="not rlq_daily_report" colspan="2"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_rlq_survey_pending_events"
              name="Surveys not completed"
              parent="menu_rlq_reports_events"
              action="action_rlq_survey_pending"
              sequence="20"
              groups="event.group_event_user"/>
    <menuitem id="menu_rlq_survey_pending_survey"
              name="Surveys not completed (registrations)"
              parent="menu_rlq_survey_report_in_survey_app"
              action="action_rlq_survey_pending"
              sequence="93"
              groups="event.group_event_user"/>

    <!-- v1.140.0 - Device of the participation (survey_device.py), in the form of a participation of the Surveys app. -->
    <record id="view_survey_user_input_form_rlq_device" model="ir.ui.view">
        <field name="name">survey.user_input.form.rlq.device</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Device" name="rlq_device">
                    <field name="rlq_os"/>
                    <field name="rlq_browser"/>
                    <field name="rlq_user_agent"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- v1.141.0 - Survey in « live session » mode (survey_live_session.py): warning and safe repair on the survey form.
         xpath on //sheet, which exists in every version (see rlq_survey_report_views.xml). -->
    <record id="view_survey_survey_form_rlq_live_session" model="ir.ui.view">
        <field name="name">survey.survey.form.rlq.live.session</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="rlq_live_session_warning" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="not rlq_live_session_warning">
                    <p class="fw-bold mb-1">Live session mode: the participants wait for a host.</p>
                    <p class="mb-1">Every person who opens this survey sees « wait for the host to go to the next question » and cannot go further than the first question.</p>
                    <p class="mb-1">Do not use « End Live Session » of Odoo: it marks EVERY participation as completed, even the unfinished ones.</p>
                    <span>Participations waiting:</span>
                    <field name="rlq_stuck_session_count" readonly="1" class="oe_inline ms-1 me-3"/>
                    <button name="action_rlq_close_live_session" type="object" class="btn btn-danger"
                            string="Close the live session (keep the answers)"
                            confirm="Close the live session? The blocked participants will continue after reloading the page; no participation is marked completed."/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
