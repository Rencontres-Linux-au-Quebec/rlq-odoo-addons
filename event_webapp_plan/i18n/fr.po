#. module: event_webapp_plan
#: model:ir.module.category,description:event_webapp_plan.module_category_event_webapp
msgid ""
"\n"
"            Access to the event day web app (/webapp_event) and to its\n"
"            configuration.\n"
"        "
msgstr ""
"\n"
"            Accès à l'application web de la journée d'événement (/"
"webapp_event) et à sa configuration.\n"
"        "

#. module: event_webapp_plan
#: model:res.groups,comment:event_webapp_plan.group_event_webapp_manager
msgid ""
"\n"
"            Creates and edits the event days: opening window, announcement,\n"
"            links, events, raffles, plan and rooms.\n"
"        "
msgstr ""
"\n"
"            Crée et modifie les journées d'événement : plage d'ouverture, "
"annonce, liens, événements, tirages, plan et salles.\n"
"        "

#. module: event_webapp_plan
#: model:ir.module.category,description:event_webapp_plan.module_category_event_webapp_room
msgid ""
"\n"
"            One group per room of the event web app: the users who entered\n"
"            the room page, allowed to read and write in its chat.\n"
"        "
msgstr ""
"\n"
"            Un groupe par salle de l'application web d'événement : les "
"utilisateurs qui sont entrés dans la page de la salle, autorisés à lire et à "
"écrire dans sa discussion.\n"
"        "

#. module: event_webapp_plan
#: model:res.groups,comment:event_webapp_plan.group_event_webapp_moderator
msgid ""
"\n"
"            Reads the event days, sees the web app outside its opening\n"
"            window, to test it, and reads every room chat.\n"
"        "
msgstr ""
"\n"
"            Consulte les journées d'événement, voit l'application web en "
"dehors de sa plage d'ouverture, pour la tester, et lit la discussion de "
"chaque salle.\n"
"        "

