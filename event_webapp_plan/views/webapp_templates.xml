    Pages of the event web app (/webapp_event). They build on web.layout only:
    no website header or footer, no web.assets_frontend. The module bundle
    event_webapp_plan.assets_webapp brings all the style and script, scoped
    under the body class o_ewp_webapp. The controller passes plain values;
    the templates never read a model.

    The layout holds the preview banner; each page draws its own bar: the
    day header on the home page, an app bar with a back link on a room page,
    a full-screen dark page when the day cannot be shown. Icons are inline
    SVG marked aria-hidden; their meaning is always carried by a text.

    Theme hooks: the templates webapp_brand and webapp_slot_* are the places
    a theme module inherits. The slots render nothing here; they receive
    ewp_page (home, room, closed, none, bbb_left) and day_state (before,
    open, after, or False without a day). The root element .o_ewp_app
    carries the same two values as data attributes, and the body the
    classes o_ewp_page_<page> and o_ewp_day_<state>.

    Accessibility: every page starts with skip links (main content,
    display options) and ends with the display options (text-only mode,
    animations), forms that post to /webapp_event/preferences and work
    without script. One polite live region, #o_ewp_announcer, carries
    every announcement of the page script, from the translated texts of its
    data-ewp-messages attribute. In text-only mode (text_only) the pages
    render no plan image, no decorative image and no mascot or banner slot;
    the body then carries o_ewp_text_only. The body carries
    o_ewp_motion_<motion>, the animation mode in force (auto, on, off; off
    in text-only mode), and o_ewp_motion_paused whenever the user stopped
    the animations (motion_paused).
-->
<odoo>
    <template id="webapp_layout" name="Event web app: layout">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': lang_attr}"/>
            <t t-set="title" t-value="page_title"/>
            <t t-set="x_icon" t-value="icon_url"/>
            <t t-set="body_classname" t-value="'o_ewp_webapp o_ewp_page_%s o_ewp_day_%s %s%s%s' % (ewp_page, day_state or 'none', ewp_body_class or '', ' o_ewp_text_only' if text_only else '', ' o_ewp_motion_%s%s' % (motion or 'auto', ' o_ewp_motion_paused' if motion_paused else ''))"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" t-att-content="theme_color"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
                <meta name="robots" content="noindex"/>
                <link rel="manifest" t-att-href="manifest_url"/>
                <link rel="apple-touch-icon" t-att-href="icon_url"/>
                <t t-call-assets="event_webapp_plan.assets_webapp"/>
            </t>
            <div class="o_ewp_app" t-att-data-ewp-sw-url="sw_url" t-att-data-ewp-sw-scope="sw_scope"
                 t-att-data-ewp-page="ewp_page" t-att-data-ewp-day-state="day_state or 'none'"
                 t-att-data-ewp-day-start="day_start" t-att-data-ewp-day-end="day_end">
                <div class="o_ewp_skiplinks">
                    <a class="o_ewp_skip" href="#o_ewp_main">Skip to main content</a>
                    <a class="o_ewp_skip" href="#o_ewp_prefs">Display options: text-only mode</a>
                </div>
                <div t-if="is_preview" class="o_ewp_preview_banner">
                    <svg class="o_ewp_icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span>
                        <strong>Preview outside opening hours.</strong> Only moderators and administrators see this page.
                        <t t-if="window_label">Opening hours: <t t-out="window_label"/></t>
                    </span>
                </div>
                <t t-out="0"/>
                <t t-call="event_webapp_plan.webapp_preferences"/>
                <!-- The one live region of the page: webapp.js writes each
                     announcement there, from the texts of data-ewp-messages. -->
                <div id="o_ewp_announcer" class="o_ewp_sr_only" role="status" aria-live="polite" aria-atomic="true"
                     t-att-data-ewp-messages="messages_json"/>
                <t t-call="event_webapp_plan.webapp_slot_footer"/>
            </div>
        </t>
    </template>

    <!-- Display options of every page, forms that post to the preferences
         route and come back to the page. Text-only mode: one toggle button
         (aria-pressed). Animations: a group of three buttons, "Follow the
         device", "On" and "Off", the one in force pressed; under "Follow
         the device", when the device asks for less motion, the hint
         .o_ewp_motion_hint shows (CSS, no script) with a button that
         turns them on. webapp.js sends the animation form without leaving
         the page; the text-only mode loads the page again, since the
         server renders it. The animation form is absent in text-only
         mode, which has no animation. -->
    <template id="webapp_preferences" name="Event web app: display options">
        <footer id="o_ewp_prefs" class="o_ewp_prefs" tabindex="-1" aria-labelledby="o_ewp_h_prefs">
            <h2 id="o_ewp_h_prefs" class="o_ewp_sr_only">Display options</h2>
            <form class="o_ewp_pref_form" method="post" t-att-action="preferences_url" data-ewp-pref="text_only">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" t-att-value="return_path"/>
                <button type="submit" id="o_ewp_text_only_toggle" class="o_ewp_pref_toggle" name="text_only"
                        t-att-value="'0' if text_only else '1'"
                        t-att-aria-pressed="'true' if text_only else 'false'">
                    Text-only mode
                </button>
            </form>
            <form t-if="not text_only" class="o_ewp_pref_form o_ewp_motion_form" method="post" t-att-action="preferences_url" data-ewp-pref="motion">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" t-att-value="return_path"/>
                <div id="o_ewp_motion" class="o_ewp_motion_choices" role="group" aria-labelledby="o_ewp_motion_label">
                    <span id="o_ewp_motion_label" class="o_ewp_motion_label">Animations</span>
                    <button type="submit" id="o_ewp_motion_choice_auto" class="o_ewp_pref_toggle o_ewp_motion_choice"
                            name="motion" value="auto" t-att-aria-pressed="'true' if motion_choice == 'auto' else 'false'">Follow the device</button>
                    <button type="submit" id="o_ewp_motion_choice_on" class="o_ewp_pref_toggle o_ewp_motion_choice"
                            name="motion" value="on" t-att-aria-pressed="'true' if motion_choice == 'on' else 'false'">On</button>
                    <button type="submit" id="o_ewp_motion_choice_off" class="o_ewp_pref_toggle o_ewp_motion_choice"
                            name="motion" value="off" t-att-aria-pressed="'true' if motion_choice == 'off' else 'false'">Off</button>
                </div>
                <p id="o_ewp_motion_hint" class="o_ewp_motion_hint">
                    <span>Your device asks for less motion, animations are off.</span>
                    <button type="submit" id="o_ewp_motion_hint_on" class="o_ewp_motion_hint_on" name="motion" value="on">Turn them on</button>
                </p>
            </form>
        </footer>
    </template>

    <!-- Theme slots, empty here. A theme inherits them with
         <xpath expr="." position="inside">. -->
    <template id="webapp_slot_mascot" name="Event web app: mascot slot"/>
    <template id="webapp_slot_banner" name="Event web app: banner slot"/>
    <template id="webapp_slot_home_lead" name="Event web app: home lead slot"/>
    <template id="webapp_slot_home_cards" name="Event web app: home cards slot"/>
    <!-- Inside each link of the room list of the home page, after the room
         description: receives `room`, the values of that room. -->
    <template id="webapp_slot_room_item" name="Event web app: room list item slot"/>
    <!-- Last item of the main content of a room page, after the chat. -->
    <template id="webapp_slot_room_main" name="Event web app: room page slot"/>
    <template id="webapp_slot_footer" name="Event web app: footer slot"/>

    <!-- Brand of the app bars: the app icon on an accent square and the app
         label, two items of the header grid. -->
    <template id="webapp_brand" name="Event web app: brand">
        <span t-if="not text_only" class="o_ewp_logo" aria-hidden="true">
            <img t-att-src="icon_url" alt="" width="36" height="36"/>
        </span>
        <span class="o_ewp_app_label">Event Web App</span>
    </template>

    <template id="webapp_logout" name="Event web app: log out link">
        <a class="o_ewp_logout" t-att-href="logout_url">
            <svg class="o_ewp_icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l-5-5 5-5"/><path d="M5 12h11"/></svg>
            <span class="o_ewp_logout_text">Log out</span>
        </a>
    </template>

    <template id="webapp_icon_external" name="Event web app: external link icon">
        <svg class="o_ewp_icon o_ewp_icon_external" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
        <!-- Visible in text-only mode, where the icon is not shown. -->
        <span class="o_ewp_sr_only o_ewp_external_text">(opens in a new tab)</span>
    </template>

    <!-- Full-screen dark page: no event day, or a day outside its window. -->
    <template id="webapp_page_none" name="Event web app: no event day">
        <t t-call="event_webapp_plan.webapp_layout">
            <t t-set="ewp_body_class" t-value="'o_ewp_webapp_closed'"/>
            <main id="o_ewp_main" class="o_ewp_closed" tabindex="-1">
                <div class="o_ewp_closed_brand">
                    <t t-call="event_webapp_plan.webapp_brand"/>
                </div>
                <div class="o_ewp_closed_body">
                    <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_mascot"/>
                    <span t-if="not text_only" class="o_ewp_closed_icon" aria-hidden="true">
                        <svg class="o_ewp_icon" width="30" height="30" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
                    </span>
                    <div class="o_ewp_closed_text">
                        <h1>No event day is configured</h1>
                        <p>There is no event day to show at the moment. Come back later.</p>
                    </div>
                </div>
                <t t-call="event_webapp_plan.webapp_closed_footer"/>
            </main>
        </t>
    </template>

    <template id="webapp_closed_footer" name="Event web app: signed-in footer">
        <div class="o_ewp_closed_footer">
            <p class="o_ewp_signed_in">Signed in as <t t-out="user_name"/></p>
            <a class="o_ewp_button_outline" t-att-href="logout_url">Log out</a>
        </div>
    </template>

    <template id="webapp_page_closed" name="Event web app: closed">
        <t t-call="event_webapp_plan.webapp_layout">
            <t t-set="ewp_body_class" t-value="'o_ewp_webapp_closed'"/>
            <main id="o_ewp_main" class="o_ewp_closed" tabindex="-1">
                <div class="o_ewp_closed_brand">
                    <t t-call="event_webapp_plan.webapp_brand"/>
                </div>
                <div class="o_ewp_closed_body">
                    <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_mascot"/>
                    <span t-if="not text_only" class="o_ewp_closed_icon" aria-hidden="true">
                        <svg class="o_ewp_icon" width="30" height="30" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </span>
                    <div class="o_ewp_closed_text">
                        <h1>
                            <t t-out="webapp.name"/>
                            <t t-if="not_started">is not open yet</t>
                            <t t-else="">is over</t>
                        </h1>
                        <p t-if="not_started">The plan, the rooms and the discussions are open during the day. Come back at the opening.</p>
                        <p t-else="">Thank you for taking part!</p>
                    </div>
                    <dl t-if="opening and closing" class="o_ewp_window_grid">
                        <div>
                            <dt>Opening</dt>
                            <dd><t t-out="opening['date']"/><br/><t t-out="opening['time']"/></dd>
                        </div>
                        <div>
                            <dt>Closing</dt>
                            <dd><t t-out="closing['date']"/><br/><t t-out="closing['time']"/></dd>
                        </div>
                    </dl>
                </div>
                <t t-call="event_webapp_plan.webapp_closed_footer"/>
            </main>
        </t>
    </template>

    <!-- Home page. The DOM order is the reading order of every width:
         the lead cards of a theme, the announcement and the links, then
         the main column (theme cards, plan, events), then the raffles. On
         phones the wrappers vanish (display: contents) and the cards follow
         one another; from 1024 px a grid puts the lead cards over the main
         column on the left and the two others in a 380 px column on the
         right, one under the other. The lead wrapper, and the class
         o_ewp_home_lead of main that sets that grid, exist only when the
         lead slot renders something. In text-only mode the page stays one
         column, without the plan image.

         The header is the banner landmark: it holds the day bar and the
         banner slot, so the banner of a theme is inside a landmark. -->
    <template id="webapp_page_main" name="Event web app: event day">
        <t t-call="event_webapp_plan.webapp_layout">
            <header class="o_ewp_header">
                <div class="o_ewp_topbar o_ewp_dayhead">
                    <t t-call="event_webapp_plan.webapp_brand"/>
                    <div class="o_ewp_user">
                        <span class="o_ewp_avatar" aria-hidden="true" t-out="user_initials"/>
                        <span class="o_ewp_user_name">
                            <t t-out="user_name"/>
                            <span t-if="user_role" class="o_ewp_user_role" t-out="user_role"/>
                        </span>
                        <t t-call="event_webapp_plan.webapp_logout"/>
                    </div>
                    <h1 class="o_ewp_day_title" t-out="webapp.name"/>
                    <div class="o_ewp_day_meta">
                        <span class="o_ewp_sr_only">State of the day:</span>
                        <span t-if="day_state == 'open'" class="o_ewp_pill o_ewp_pill_open"><span class="o_ewp_pill_dot" aria-hidden="true"/>In progress</span>
                        <span t-elif="day_state == 'before'" class="o_ewp_pill o_ewp_pill_closed"><span class="o_ewp_pill_dot" aria-hidden="true"/>Not open yet</span>
                        <span t-elif="day_state == 'after'" class="o_ewp_pill o_ewp_pill_closed"><span class="o_ewp_pill_dot" aria-hidden="true"/>Over</span>
                        <span t-if="window_label" class="o_ewp_window" t-out="window_label"/>
                    </div>
                    <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_mascot"/>
                </div>
                <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_banner"/>
            </header>

            <t t-set="home_lead"><t t-call="event_webapp_plan.webapp_slot_home_lead"/></t>
            <t t-set="has_home_lead" t-value="bool(home_lead and home_lead.strip())"/>
            <main id="o_ewp_main" t-attf-class="o_ewp_main o_ewp_home #{'o_ewp_home_lead' if has_home_lead else ''}" tabindex="-1">
                <div t-if="has_home_lead" class="o_ewp_column o_ewp_column_lead" t-out="home_lead"/>
                <div t-if="announcement or links" class="o_ewp_column o_ewp_column_side o_ewp_column_side_top">
                    <section t-if="announcement" class="o_ewp_card o_ewp_announcement" aria-labelledby="o_ewp_h_announcement">
                        <div class="o_ewp_card_title">
                            <svg class="o_ewp_icon o_ewp_icon_warm" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
                            <h2 id="o_ewp_h_announcement">Announcement</h2>
                        </div>
                        <div class="o_ewp_rich" t-out="announcement"/>
                    </section>

                    <section t-if="links" class="o_ewp_links_card" aria-labelledby="o_ewp_h_links">
                        <h2 id="o_ewp_h_links">Links</h2>
                        <ul class="o_ewp_links" role="list">
                            <li t-foreach="links" t-as="link">
                                <a class="o_ewp_link" t-att-href="link['url']" target="_blank" rel="noopener noreferrer">
                                    <span class="o_ewp_link_text">
                                        <span class="o_ewp_link_label" t-out="link['name']"/>
                                        <span t-if="link['description']" class="o_ewp_link_hint" t-out="link['description']"/>
                                    </span>
                                    <t t-call="event_webapp_plan.webapp_icon_external"/>
                                </a>
                            </li>
                        </ul>
                    </section>
                </div>

                <div class="o_ewp_column o_ewp_column_main">
                    <t t-call="event_webapp_plan.webapp_slot_home_cards"/>
                    <section t-if="rooms or plan_url" class="o_ewp_card o_ewp_plan_card" aria-labelledby="o_ewp_h_plan">
                        <div class="o_ewp_card_head">
                            <h2 id="o_ewp_h_plan">
                                <t t-if="text_only">Rooms</t>
                                <t t-else="">Site plan</t>
                            </h2>
                            <p t-if="rooms" class="o_ewp_hint">Choose a room to enter it.</p>
                        </div>
                        <!-- The plan is a picture for the eyes: its areas
                             repeat the room list below, which carries the
                             names, the states and the position words, so
                             they are hidden from assistive technologies and
                             left out of the tab order. -->
                        <div t-if="plan_url and not text_only" class="o_ewp_plan">
                            <img t-if="rooms" class="o_ewp_plan_image" t-att-src="plan_url"
                                 alt="Site plan. The rooms are listed after the plan, as links."/>
                            <img t-else="" class="o_ewp_plan_image" t-att-src="plan_url" alt="Site plan."/>
                            <t t-foreach="rooms" t-as="room">
                                <a t-if="room['on_plan']" class="o_ewp_hotspot"
                                   t-att-href="room['url']" t-att-style="room['style']"
                                   aria-hidden="true" tabindex="-1" t-att-data-ewp-room-id="room['id']">
                                    <span class="o_ewp_hotspot_number" t-out="room['number']"/>
                                    <span class="o_ewp_hotspot_label" t-out="room['name']"/>
                                </a>
                            </t>
                        </div>
                        <!-- data-ewp-live-url: the page script asks it
                             which meetings run, then marks their room
                             (data-ewp-live on the area and the link) and
                             shows the hidden "Live" pill of the link. -->
                        <ul t-if="rooms" class="o_ewp_rooms" role="list" t-att-data-ewp-live-url="rooms_live_url or None">
                            <li t-foreach="rooms" t-as="room">
                                <a class="o_ewp_room_link" t-att-href="room['url']"
                                   t-att-data-ewp-room-id="room['id']"
                                   t-attf-style="--ewp-room-color:#{room['color']};--ewp-room-ink:#{room['text_color']}">
                                    <span t-if="not text_only" class="o_ewp_room_badge" aria-hidden="true" t-out="room['number']"/>
                                    <span class="o_ewp_room_text">
                                        <span class="o_ewp_room_name" t-out="room['name']"/>
                                        <span t-if="room['description']" class="o_ewp_room_description" t-out="room['description']"/>
                                        <span t-if="room['position'] and plan_url and not text_only" class="o_ewp_sr_only o_ewp_room_position" t-out="room['position']"/>
                                        <t t-call="event_webapp_plan.webapp_slot_room_item"/>
                                    </span>
                                    <span t-if="room['video']" class="o_ewp_pill o_ewp_pill_video"><svg class="o_ewp_icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3"/></svg>Video <span class="o_ewp_sr_only">conference</span></span>
                                    <span t-if="room['meeting']" class="o_ewp_pill o_ewp_pill_onair o_ewp_pill_live" hidden="hidden"><span class="o_ewp_pill_dot" aria-hidden="true"/><span class="o_ewp_sr_only">Conference:</span> Live</span>
                                    <svg class="o_ewp_icon o_ewp_chevron" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                                </a>
                            </li>
                        </ul>
                    </section>

                    <section t-if="events" class="o_ewp_card o_ewp_events_card" aria-labelledby="o_ewp_h_events">
                        <h2 id="o_ewp_h_events">Today's events</h2>
                        <ol class="o_ewp_events" role="list">
                            <li t-foreach="events" t-as="event" class="o_ewp_event">
                                <span class="o_ewp_event_time" t-out="event['time']"/>
                                <span class="o_ewp_event_text">
                                    <span class="o_ewp_event_name" t-out="event['name']"/>
                                    <span t-if="event['address']" class="o_ewp_event_address" t-out="event['address']"/>
                                </span>
                            </li>
                        </ol>
                    </section>
                </div>

                <div t-if="has_raffles" class="o_ewp_column o_ewp_column_side o_ewp_column_side_bottom">
                    <section class="o_ewp_card o_ewp_raffles_card" aria-labelledby="o_ewp_h_raffles">
                        <div class="o_ewp_card_head o_ewp_card_head_row">
                            <div class="o_ewp_card_title">
                                <svg class="o_ewp_icon o_ewp_icon_warm" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v8H4v-8"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg>
                                <h2 id="o_ewp_h_raffles" tabindex="-1">Raffles</h2>
                            </div>
                            <!-- Age of the last answer of the live refresh,
                                 written by the page script from these two
                                 translated patterns. -->
                            <span class="o_ewp_updated" aria-hidden="true"
                                  t-att-data-ewp-label-seconds="raffles_updated_seconds"
                                  t-att-data-ewp-label-minutes="raffles_updated_minutes"/>
                        </div>
                        <!-- Shown by webapp.js when new results wait while
                             the animations are paused: the block is then
                             replaced on demand only. -->
                        <button type="button" class="o_ewp_button o_ewp_raffles_apply" hidden="hidden">Show the latest results</button>
                        <!-- The block is replaced as a whole on each change,
                             so it is not a live region: the shared region
                             #o_ewp_announcer announces the new winners. -->
                        <div class="o_ewp_raffles"
                             t-att-data-ewp-raffles-url="raffles_url"
                             t-att-data-ewp-signature="raffles_signature">
                            <t t-call="event_webapp_plan.webapp_raffles_content"/>
                        </div>
                    </section>
                </div>
            </main>
        </t>
    </template>

    <!-- Raffle block: rendered in the page and again by the /raffles JSON
         route for the live refresh. It only receives plain values. -->
    <template id="webapp_raffles_content" name="Event web app: raffles">
        <p t-if="not raffles" class="o_ewp_hint">No raffle for this day yet.</p>
        <article t-foreach="raffles" t-as="raffle" class="o_ewp_raffle">
            <div class="o_ewp_raffle_head">
                <h3 class="o_ewp_raffle_title">
                    <span t-out="raffle['name']"/>
                    <span t-if="raffle['state_label']" t-attf-class="o_ewp_badge o_ewp_state_#{raffle['state']}" t-out="raffle['state_label']"/>
                </h3>
                <span t-if="raffle['progress']" class="o_ewp_raffle_progress" t-out="raffle['progress']"/>
            </div>
            <p t-if="not raffle['draws']" class="o_ewp_hint">No draw planned yet.</p>
            <ol t-else="" class="o_ewp_draws" role="list">
                <li t-foreach="raffle['draws']" t-as="draw"
                    t-att-data-ewp-draw-id="draw['id']"
                    t-attf-class="o_ewp_draw #{'o_ewp_draw_done' if draw['drawn'] else 'o_ewp_draw_pending'} #{'o_ewp_draw_absent' if draw['is_absent'] else ''}">
                    <span class="o_ewp_draw_seq" aria-hidden="true" t-out="draw['sequence']"/>
                    <span class="o_ewp_draw_body">
                        <span class="o_ewp_draw_prize" t-out="draw['prize']"/>
                        <span t-if="draw['prize_description']" class="o_ewp_draw_prize_description" t-out="draw['prize_description']"/>
                        <span t-if="draw['drawn']" class="o_ewp_draw_winner">
                            <span class="o_ewp_winner_label">Winner:</span>
                            <span class="o_ewp_winner_name" t-out="draw['winner_name']"/>
                            <span t-if="draw['time']" class="o_ewp_draw_time" t-out="draw['time']"/>
                        </span>
                        <span t-else="" class="o_ewp_to_draw">To be drawn</span>
                    </span>
                    <span t-if="draw['is_absent']" class="o_ewp_badge o_ewp_badge_absent">Absent</span>
                </li>
            </ol>
        </article>
    </template>

    <template id="webapp_page_room" name="Event web app: room">
        <t t-call="event_webapp_plan.webapp_layout">
            <t t-set="ewp_body_class" t-value="'o_ewp_webapp_room'"/>
            <!-- The header is the banner landmark: the app bar and the
                 banner slot. -->
            <header class="o_ewp_header">
                <div class="o_ewp_topbar o_ewp_appbar" t-attf-style="--ewp-room-color:#{room['color']}">
                    <a class="o_ewp_back" t-att-href="home_url">
                        <svg class="o_ewp_icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                        <span class="o_ewp_back_text">Back to the plan</span>
                    </a>
                    <div class="o_ewp_appbar_text">
                        <h1 class="o_ewp_room_title" t-out="room['name']"/>
                        <p t-if="room['description']" class="o_ewp_room_description" t-out="room['description']"/>
                    </div>
                    <span t-if="bbb and bbb['live']" class="o_ewp_pill o_ewp_pill_onair"><span class="o_ewp_pill_dot" aria-hidden="true"/><span class="o_ewp_sr_only">Conference:</span> Live</span>
                    <span class="o_ewp_user_name" t-out="user_name"/>
                    <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_mascot"/>
                </div>
                <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_banner"/>
            </header>
            <!-- Conference (bbb) above the chat on phones, on the left of a
                 380 px chat column on wide screens; one column in text-only
                 mode. -->
            <main id="o_ewp_main" tabindex="-1" t-attf-class="o_ewp_room_page o_ewp_room_body #{'o_ewp_room_body_split' if bbb else ''}">
                <!-- data-ewp-bbb-state: running (meeting ID mode, meeting
                     runs, in the frame), left (the same, on the page the
                     redirect of bbb_left gives a tab that left the
                     meeting), frame (framed conference URL), waiting,
                     unavailable or button (new tab, for a running meeting
                     too); webapp.js updates it. data-ewp-bbb-live: the
                     server says the meeting runs. -->
                <section t-if="bbb" class="o_ewp_bbb" aria-labelledby="o_ewp_h_bbb"
                         t-att-data-ewp-bbb-state="bbb['page_state']"
                         t-att-data-ewp-bbb-live="'1' if bbb['live'] else '0'">
                    <h2 id="o_ewp_h_bbb" class="o_ewp_sr_only" tabindex="-1">Video conference</h2>
                    <p t-if="bbb['error']" class="o_ewp_bbb_notice">
                        The video conference server does not answer at the moment.
                    </p>
                    <!-- The frame loads the bbb_join route, which
                         redirects to the join URL or the conference URL.
                         The features are granted to every origin (*): the
                         redirect reaches the client on another host (load
                         balancer, separate front end), and a bare feature
                         name only covers the origin of src. The frame only
                         loads a URL set by an administrator. -->
                    <t t-if="bbb['state'] == 'frame'">
                        <!-- Text-only mode: the frame ships hidden and
                             without src; this button gives it its src
                             (data-ewp-src) and shows it. "Open in a new
                             tab" below works in both modes. bbb['left']:
                             the frame ships hidden and without src, the
                             notice of the leave shown, in both modes. -->
                        <div t-if="text_only and not bbb['left']" class="o_ewp_bbb_ondemand">
                            <p class="o_ewp_hint">The conference opens in its own player, which has its own keyboard shortcuts and screen reader support.</p>
                            <button type="button" class="o_ewp_button o_ewp_bbb_show" aria-controls="o_ewp_video" aria-expanded="false">Show the video conference</button>
                        </div>
                        <div id="o_ewp_video" class="o_ewp_video" t-att-hidden="'hidden' if text_only and not bbb['left'] else None">
                            <iframe class="o_ewp_bbb_frame" t-att-src="None if text_only or bbb['left'] else bbb['frame_url']"
                                    t-att-hidden="'hidden' if bbb['left'] else None"
                                    t-att-data-ewp-src="bbb['frame_url']"
                                    t-att-title="bbb['title']"
                                    allow="camera *; microphone *; display-capture *; fullscreen *; autoplay *; clipboard-write *"
                                    allowfullscreen="allowfullscreen"
                                    referrerpolicy="no-referrer"/>
                            <!-- Shown by webapp.js in place of the frame once
                                 the conference opens in another tab, so the
                                 user is not in the meeting twice. -->
                            <div class="o_ewp_bbb_moved" hidden="hidden">
                                <p class="o_ewp_bbb_waiting_title">The conference is open in another tab.</p>
                                <p class="o_ewp_hint">Reload this page to bring it back here.</p>
                            </div>
                            <!-- Meeting ID mode only. Shown by webapp.js in
                                 place of the frame once the user leaves the
                                 meeting (the frame reaches left_url, the
                                 logoutURL of the join URL, or loads another
                                 page after the client). "Join again" asks
                                 check_url (the status route, without its
                                 cache), then loads frame_url again. -->
                            <div t-if="bbb['live']" class="o_ewp_bbb_left" t-att-hidden="None if bbb['left'] else 'hidden'"
                                 t-att-data-ewp-bbb-left-path="bbb['left_url']"
                                 t-att-data-ewp-bbb-check-url="bbb['check_url']">
                                <p class="o_ewp_bbb_waiting_title">You left the conference.</p>
                                <button type="button" class="o_ewp_button o_ewp_bbb_rejoin">Join again</button>
                            </div>
                        </div>
                        <div class="o_ewp_video_bar">
                            <span class="o_ewp_video_caption">Video conference</span>
                            <a class="o_ewp_bbb_newtab" t-att-href="bbb['join_url']" target="_blank" rel="noopener">
                                Open in a new tab
                                <t t-call="event_webapp_plan.webapp_icon_external"/>
                            </a>
                        </div>
                    </t>
                    <!-- data-ewp-bbb-status-url: the page script polls the
                         status route and loads the page again when its
                         state or its error changes (waiting, unavailable,
                         a running meeting behind the button, a server that
                         fails). -->
                    <div t-elif="bbb['state'] in ('waiting', 'unavailable')" class="o_ewp_bbb_waiting"
                         t-att-data-ewp-bbb-status-url="bbb['status_url']"
                         t-att-data-ewp-bbb-error="'1' if bbb['error'] else '0'">
                        <p t-if="bbb['state'] == 'waiting'" class="o_ewp_bbb_waiting_title">The conference has not started yet.</p>
                        <p class="o_ewp_hint">This page reloads by itself as soon as the conference starts.</p>
                    </div>
                    <!-- New tab: the server is on another site (the
                         browser would refuse the session cookie of the
                         client in a frame), the display setting asks for
                         it, or the conference URL refuses a frame. -->
                    <div t-elif="bbb['state'] == 'button'"
                         t-attf-class="o_ewp_bbb_waiting o_ewp_bbb_tab #{'o_ewp_bbb_tab_live' if bbb['live'] else ''}"
                         t-att-data-ewp-bbb-status-url="bbb['status_url'] if bbb['poll'] else None"
                         t-att-data-ewp-bbb-error="('1' if bbb['error'] else '0') if bbb['poll'] else None">
                        <p t-if="bbb['live']" class="o_ewp_bbb_waiting_title">The video conference is live.</p>
                        <a class="o_ewp_button o_ewp_bbb_join" t-att-href="bbb['join_url']" target="_blank" rel="noopener">
                            <t t-if="bbb['live']">Join the video conference</t>
                            <t t-else="">Join the conference</t>
                            <t t-call="event_webapp_plan.webapp_icon_external"/>
                        </a>
                        <p class="o_ewp_hint">It opens in a new tab: this page and its discussion stay open.</p>
                    </div>
                </section>
                <section class="o_ewp_chat_section" aria-labelledby="o_ewp_h_chat">
                    <h2 id="o_ewp_h_chat" class="o_ewp_sr_only">Discussion</h2>
                    <iframe t-if="chat_url" class="o_ewp_chat" t-att-src="chat_url"
                            t-att-title="chat_title"
                            allow="camera; microphone; display-capture; fullscreen; autoplay"/>
                    <div t-elif="chat_restricted" class="o_ewp_card o_ewp_message">
                        <p>The discussion of this room is not open to your account.</p>
                    </div>
                    <div t-else="" class="o_ewp_card o_ewp_message">
                        <p>This room has no discussion yet.</p>
                    </div>
                </section>
                <t t-call="event_webapp_plan.webapp_slot_room_main"/>
            </main>
        </t>
    </template>

    <!-- logoutURL of the join URL of the conference frame (bbb_left with
         frame=1): the client of BigBlueButton loads it once the user
         leaves, and the room page replaces it at once with its own notice.
         Its link leads back to the room should it show on its own. -->
    <template id="webapp_page_bbb_left" name="Event web app: conference left">
        <t t-call="event_webapp_plan.webapp_layout">
            <t t-set="ewp_body_class" t-value="'o_ewp_webapp_closed'"/>
            <main id="o_ewp_main" class="o_ewp_closed" tabindex="-1">
                <div class="o_ewp_closed_brand">
                    <t t-call="event_webapp_plan.webapp_brand"/>
                </div>
                <div class="o_ewp_closed_body">
                    <t t-if="not text_only" t-call="event_webapp_plan.webapp_slot_mascot"/>
                    <span t-if="not text_only" class="o_ewp_closed_icon" aria-hidden="true">
                        <svg class="o_ewp_icon" width="30" height="30" viewBox="0 0 24 24"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3"/></svg>
                    </span>
                    <div class="o_ewp_closed_text">
                        <h1>You left the conference.</h1>
                        <p t-out="room['name']"/>
                    </div>
                </div>
                <div class="o_ewp_closed_footer">
                    <a class="o_ewp_button_outline" t-att-href="room_url" target="_top">Back to the room</a>
                </div>
            </main>
        </t>
    </template>
</odoo>
