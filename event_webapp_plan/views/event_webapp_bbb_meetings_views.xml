<odoo>
    <record id="event_webapp_bbb_meetings_view_form" model="ir.ui.view">
        <field name="name">event.webapp.bbb.meetings.form</field>
        <field name="model">event.webapp.bbb.meetings</field>
        <field name="arch" type="xml">
            <form string="Running BBB meetings">
                <field name="webapp_id" invisible="1" />
                <field name="meeting_count" invisible="1" />
                <p class="text-muted">
                    Meetings currently known by the BigBlueButton server. A
                    Greenlight room appears here once its host has started
                    it. Choose a room, then assign: the room page joins
                    that meeting.
                </p>
                <p invisible="meeting_count" class="alert alert-info" role="status">
                    No meeting is running on the server.
                </p>
                <field name="line_ids" invisible="not meeting_count" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="webapp_id" column_invisible="True" />
                        <field name="meeting_name" />
                        <field name="meeting_id" />
                        <field name="participant_count" />
                        <field name="running" />
                        <field name="room_id" options="{'no_create': True, 'no_open': True}" />
                        <button name="action_assign" type="object" string="Assign" icon="fa-link" />
                    </list>
                </field>
                <footer>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary" />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
