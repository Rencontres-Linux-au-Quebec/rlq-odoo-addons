<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_draw_view_list_prize_claim" model="ir.ui.view">
        <field name="name">event.raffle.draw.list.prize.claim</field>
        <field name="model">event.raffle.draw</field>
        <field name="inherit_id" ref="event_raffle_prize.event_raffle_draw_view_list_prize" />
        <field name="arch" type="xml">
            <field name="claim_state" position="after">
                <field name="claim_link_state" optional="show" />
            </field>
        </field>
    </record>

    <record id="event_raffle_draw_view_form_prize_claim" model="ir.ui.view">
        <field name="name">event.raffle.draw.form.prize.claim</field>
        <field name="model">event.raffle.draw</field>
        <field name="inherit_id" ref="event_raffle_prize.event_raffle_draw_view_form_prize" />
        <field name="arch" type="xml">
            <button name="action_open_prize_choose_wizard" position="before">
                <button
                    name="action_claim_link_send"
                    type="object"
                    string="Send the Prize Link"
                    class="btn-secondary"
                    confirm="Send a new prize link to the winner? A link sent before stops working."
                    invisible="claim_state != 'none' or not winner_participant_id"
                    groups="event.group_event_user"
                />
            </button>
            <field name="claim_state" position="after">
                <field name="claim_link_state" />
                <field name="claim_deadline" invisible="not claim_deadline" />
                <field
                    name="claim_link_url"
                    widget="CopyClipboardChar"
                    invisible="claim_link_state != 'open'"
                    groups="event.group_event_user"
                />
            </field>
        </field>
    </record>
</odoo>
