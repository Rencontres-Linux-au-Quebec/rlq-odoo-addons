<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.event_raffle_prize_claim</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event_raffle.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='raffle_messages_setting_container']" position="after">
                <block title="Sponsored Prizes in the Shop" name="raffle_sponsored_shop_setting_container">
                    <setting
                        id="raffle_sponsored_shop"
                        help="While the switch is on and the close date, if any, is still ahead, every visitor of the website shop sees the published sponsored prizes: members buy those sold to them, the others show as prizes only. Afterwards, only the winners' prize links show them. To reopen the sales, tick the switch again and move or clear the date."
                    >
                        <field name="raffle_sponsored_shop_open" />
                        <div class="content-group mt16">
                            <div>
                                <label for="raffle_sponsored_shop_close_date" class="o_light_label" />
                            </div>
                            <field name="raffle_sponsored_shop_close_date" />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
