<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_draw_view_list" model="ir.ui.view">
        <field name="name">event.raffle.draw.list</field>
        <field name="model">event.raffle.draw</field>
        <field name="arch" type="xml">
            <list string="Winners">
                <field name="sequence" />
                <field name="raffle_id" />
                <field name="winner_name" />
                <field name="prize" />
                <field name="prize_received" />
                <field name="prize_received_date" />
                <field name="comment" />
                <field name="is_absent" />
                <field name="date" />
                <field name="notified" optional="show" />
                <field name="notification_read" optional="show" />
                <field name="notification_count" optional="show" />
                <field name="name" optional="hide" />
                <field name="partner_id" optional="hide" />
                <field name="winner_participant_id" optional="hide" />
                <field name="winner_email" optional="hide" />
                <field name="prize_description" optional="hide" />
            </list>
        </field>
    </record>

    <record id="event_raffle_draw_view_search" model="ir.ui.view">
        <field name="name">event.raffle.draw.search</field>
        <field name="model">event.raffle.draw</field>
        <field name="arch" type="xml">
            <search string="Draws">
                <field name="winner_name" />
                <field name="raffle_id" />
                <field name="partner_id" />
                <filter string="Prod" name="production" domain="[('raffle_is_test', '=', False)]" />
                <filter string="Test" name="test" domain="[('raffle_is_test', '=', True)]" />
            </search>
        </field>
    </record>

    <record id="event_raffle_draw_view_form" model="ir.ui.view">
        <field name="name">event.raffle.draw.form</field>
        <field name="model">event.raffle.draw</field>
        <field name="arch" type="xml">
            <form string="Draw">
                <header>
                    <button
                        name="action_mark_absent"
                        type="object"
                        string="Mark Absent"
                        class="btn-secondary"
                        invisible="is_absent"
                    />
                    <button
                        name="action_mark_present"
                        type="object"
                        string="Mark Present"
                        class="btn-secondary"
                        invisible="not is_absent"
                    />
                    <button
                        name="action_open_notify_wizard"
                        type="object"
                        string="Notify"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="raffle_id" />
                            <field name="sequence" />
                            <field name="winner_name" />
                            <field name="winner_email" />
                            <field name="winner_participant_id" />
                            <field name="partner_id" />
                            <field name="is_absent" />
                        </group>
                        <group>
                            <field name="prize" />
                            <field name="prize_description" />
                            <field name="date" />
                            <field name="prize_received" />
                            <field name="prize_received_date" />
                            <field name="notified" />
                            <field name="notification_read" />
                            <field name="notification_count" />
                        </group>
                    </group>
                    <group string="Comment">
                        <field
                            name="comment"
                            nolabel="1"
                            placeholder="Prize hand-over, contact details, follow-up..."
                        />
                    </group>
                    <group string="Notifications" invisible="not notification_ids">
                        <field name="notification_ids" nolabel="1" colspan="2" readonly="1">
                            <list>
                                <field name="date" />
                                <field name="channel" />
                                <field name="author_id" />
                                <field name="recipient" />
                                <field name="body" />
                                <field name="is_read" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</odoo>
