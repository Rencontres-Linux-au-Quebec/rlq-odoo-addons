<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_prize_ship_wizard_form" model="ir.ui.view">
        <field name="name">event.raffle.prize.ship.wizard.form</field>
        <field name="model">event.raffle.prize.ship.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark as Shipped">
                <div class="alert alert-info" role="status">
                    The delivery of the prize is validated and the winner receives the tracking number
                    by email. Mark the prize received once the winner has it.
                </div>
                <group>
                    <field name="draw_id" readonly="1" />
                    <field name="prize_product_id" />
                    <field name="tracking_ref" />
                    <field name="carrier_name" placeholder="Postal service, courier..." />
                </group>
                <footer>
                    <button string="Mark as Shipped" name="action_ship" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
