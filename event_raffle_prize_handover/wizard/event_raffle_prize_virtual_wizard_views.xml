<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_prize_virtual_wizard_form" model="ir.ui.view">
        <field name="name">event.raffle.prize.virtual.wizard.form</field>
        <field name="model">event.raffle.prize.virtual.wizard</field>
        <field name="arch" type="xml">
            <form string="Send the Virtual Prize">
                <div class="alert alert-info" role="status">
                    The message and the code go to the winner by email, in their language. The prize is
                    then handed over: one unit leaves the stock.
                </div>
                <group>
                    <field name="draw_id" readonly="1" />
                    <field name="prize_product_id" />
                    <field name="recipient" />
                    <field name="code" />
                </group>
                <field name="body" />
                <footer>
                    <button string="Send the Virtual Prize" name="action_send" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
