#. module: event_raffle_prize_handover
#: model:mail.template,body_html:event_raffle_prize_handover.mail_template_prize_shipped
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"prize\" t-value=\"object._raffle_prize_mail_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Hello <t t-out=\"object.partner_id.name or ''\">Winner</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Your prize is on its way: <strong t-out=\"prize['prize']\">Prize</strong>.\n"
"    </p>\n"
"    <p class=\"o_raffle_prize_tracking\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Tracking number: <strong t-out=\"prize['tracking_ref']\">0000</strong>\n"
"        <t t-if=\"prize['carrier']\">(<t t-out=\"prize['carrier']\">Carrier</t>)</t>\n"
"    </p>\n"
"    <p t-if=\"prize['sponsor_name']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Offered by\n"
"        <a t-if=\"prize['sponsor_url']\" t-att-href=\"prize['sponsor_url']\" t-out=\"prize['sponsor_name']\">Sponsor</a>\n"
"        <t t-else=\"\" t-out=\"prize['sponsor_name']\">Sponsor</t>\n"
"    </p>\n"
"    <p style=\"margin: 0px;\">Congratulations!</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"prize\" t-value=\"object._raffle_prize_mail_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Bonjour <t t-out=\"object.partner_id.name or ''\">Gagnant</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Votre prix est en route : <strong t-out=\"prize['prize']\">Prix</strong>.\n"
"    </p>\n"
"    <p class=\"o_raffle_prize_tracking\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Numéro de suivi : <strong t-out=\"prize['tracking_ref']\">0000</strong>\n"
"        <t t-if=\"prize['carrier']\">(<t t-out=\"prize['carrier']\">Transporteur</t>)</t>\n"
"    </p>\n"
"    <p t-if=\"prize['sponsor_name']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Offert par\n"
"        <a t-if=\"prize['sponsor_url']\" t-att-href=\"prize['sponsor_url']\" t-out=\"prize['sponsor_name']\">Commanditaire</a>\n"
"        <t t-else=\"\" t-out=\"prize['sponsor_name']\">Commanditaire</t>\n"
"    </p>\n"
"    <p style=\"margin: 0px;\">Félicitations !</p>\n"
"</div>\n"
"            "

#. module: event_raffle_prize_handover
#: model:mail.template,body_html:event_raffle_prize_handover.mail_template_prize_reserved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"prize\" t-value=\"object._raffle_prize_mail_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Hello <t t-out=\"object.partner_id.name or ''\">Winner</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Your prize is reserved: <strong t-out=\"prize['prize']\">Prize</strong>.\n"
"    </p>\n"
"    <p t-if=\"prize['category']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Token category: <t t-out=\"prize['category']\">Token</t>\n"
"    </p>\n"
"    <p t-if=\"prize['sponsor_name']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Offered by\n"
"        <a t-if=\"prize['sponsor_url']\" t-att-href=\"prize['sponsor_url']\" t-out=\"prize['sponsor_name']\">Sponsor</a>\n"
"        <t t-else=\"\" t-out=\"prize['sponsor_name']\">Sponsor</t>\n"
"    </p>\n"
"    <p class=\"o_raffle_prize_handover\" style=\"margin: 0px 0px 12px 0px;\" t-out=\"prize['handover']\">Pick up your prize at the event.</p>\n"
"    <p style=\"margin: 0px;\">Congratulations!</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"prize\" t-value=\"object._raffle_prize_mail_values()\"/>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">Bonjour <t t-out=\"object.partner_id.name or ''\">Gagnant</t>,</p>\n"
"    <p style=\"margin: 0px 0px 12px 0px;\">\n"
"        Votre prix est réservé : <strong t-out=\"prize['prize']\">Prix</strong>.\n"
"    </p>\n"
"    <p t-if=\"prize['category']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Catégorie de jeton : <t t-out=\"prize['category']\">Jeton</t>\n"
"    </p>\n"
"    <p t-if=\"prize['sponsor_name']\" style=\"margin: 0px 0px 12px 0px;\">\n"
"        Offert par\n"
"        <a t-if=\"prize['sponsor_url']\" t-att-href=\"prize['sponsor_url']\" t-out=\"prize['sponsor_name']\">Commanditaire</a>\n"
"        <t t-else=\"\" t-out=\"prize['sponsor_name']\">Commanditaire</t>\n"
"    </p>\n"
"    <p class=\"o_raffle_prize_handover\" style=\"margin: 0px 0px 12px 0px;\" t-out=\"prize['handover']\">Récupérez votre prix sur place, à l'événement.</p>\n"
"    <p style=\"margin: 0px;\">Félicitations !</p>\n"
"</div>\n"
"            "

