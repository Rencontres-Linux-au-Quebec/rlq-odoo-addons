<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_event_view_form_raffle_winners" model="ir.ui.view">
        <field name="name">event.event.form.raffle.winners</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='right_event_details']" position="inside">
                <field name="raffle_winners_published" groups="event.group_event_user" />
                <field
                    name="raffle_winners_url"
                    widget="url"
                    invisible="not raffle_winners_published"
                    groups="event.group_event_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
